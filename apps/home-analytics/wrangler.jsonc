{
  "name": "dailyden-home-analytics",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dailyden.games/api/home-analytics/events", "zone_name": "dailyden.games" }],
  "d1_databases": [{
    "binding": "HOME_ANALYTICS",
    "database_name": "dailyden-analytics",
    "database_id": "REPLACE_WITH_DATABASE_ID"
  }],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
